---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactCta from '../components/ContactCta.astro';
import { SITE, OFFICES } from '../data/site';
import { img } from '../lib/img';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  cta?: boolean;
  ctaTitle?: string;
  ctaText?: string;
  noindex?: boolean;
  published?: string;
}
const {
  title, description, image = 'f719546c348942a4823560e9a3dc6329.jpg', type = 'website',
  schema = [], cta = true, ctaTitle, ctaText, noindex, published,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/\/$/, '') || '/';
const canonical = new URL(pathname === '/' ? '/' : pathname, SITE.url).href;
const fullTitle = pathname === '/' ? title : `${title} | Servicios Sociales Ceuta`;
const og = await getImage({ src: img(image), width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, SITE.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentOrganization',
  '@id': `${SITE.url}/#org`,
  name: 'Servicios Sociales de la Ciudad Autónoma de Ceuta',
  alternateName: 'Consejería de Sanidad y Servicios Sociales de Ceuta',
  url: SITE.url,
  logo: new URL((await getImage({ src: img('bd108c049a6a43688b30172abf3387aa.png'), width: 600, format: 'png' })).src, SITE.url).href,
  areaServed: { '@type': 'City', name: 'Ceuta' },
  parentOrganization: { '@type': 'GovernmentOrganization', name: 'Ciudad Autónoma de Ceuta', url: 'https://www.ceuta.es' },
  department: OFFICES.map((o) => ({
    '@type': 'GovernmentOffice',
    name: `${o.name} · Servicios Sociales de Ceuta`,
    address: { '@type': 'PostalAddress', streetAddress: `${o.address}, ${o.area}`, addressLocality: 'Ceuta', postalCode: '51001', addressCountry: 'ES' },
    telephone: o.phones.map((p) => '+34 ' + p),
    openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: o.opens, closes: o.closes }],
  })),
};
const ld = [org, ...schema];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){if(!window.__gsapReady)document.documentElement.classList.remove('js')},2500);</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#13284d" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
      {cta && <ContactCta title={ctaTitle} text={ctaText} />}
    </main>
    <Footer />
    <script>
      import './../scripts/motion';
    </script>
  </body>
</html>
