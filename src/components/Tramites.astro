---
import Icon from './Icon.astro';
interface Item { label: string; href: string; note?: string }
interface Props { items: Item[]; title?: string; cols?: 1 | 2 }
const { items, title, cols = 1 } = Astro.props;
const isSede = (h: string) => h.includes('sede.ceuta.es');
---
<div class="tr">
  {title && <h3 class="tr__t">{title}</h3>}
  <ul class={`tr__list ${cols === 2 ? 'tr__list--2' : ''}`} data-stagger>
    {items.map((it) => (
      <li>
        <a href={it.href} target="_blank" rel="noopener">
          <span class="tr__ico"><Icon name={isSede(it.href) ? 'doc' : 'external'} /></span>
          <span class="tr__txt">
            <span class="tr__label">{it.label}</span>
            <span class="tr__note">{it.note ?? (isSede(it.href) ? 'Trámite en la sede electrónica' : new URL(it.href).hostname.replace('www.', ''))}</span>
          </span>
          <Icon name="arrow" class="tr__arrow" />
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .tr__t { font: 700 var(--fs-h4)/1.25 var(--font-body); margin-bottom: 1rem; }
  .tr__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  @media (min-width: 860px) { .tr__list--2 { grid-template-columns: 1fr 1fr; } }
  .tr__list a {
    display: flex; align-items: center; gap: 1rem; padding: 1rem 1.2rem; height: 100%;
    background: #fff; border: 1px solid var(--linea); border-radius: 14px; text-decoration: none; color: var(--tinta);
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s var(--ease);
  }
  .tr__list a:hover { border-color: var(--azul-400); box-shadow: var(--shadow-sm); transform: translateY(-2px); }
  .tr__ico { flex: none; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--azul-50); color: var(--azul-700); transition: background 0.3s, color 0.3s; }
  .tr__list a:hover .tr__ico { background: var(--azul-700); color: #fff; }
  .tr__txt { display: grid; gap: 0.1rem; flex: 1; }
  .tr__label { font-weight: 700; line-height: 1.3; color: var(--azul-900); }
  .tr__note { font-size: 0.86rem; color: var(--gris); }
  .tr__list :global(.tr__arrow) { flex: none; color: var(--azul-400); transition: transform 0.3s var(--ease), color 0.3s; }
  .tr__list a:hover :global(.tr__arrow) { transform: translateX(4px); color: var(--azul-700); }
</style>
