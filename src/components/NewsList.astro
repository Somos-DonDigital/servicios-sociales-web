---
import PageHero from './PageHero.astro';
import PostCard from './PostCard.astro';
import Icon from './Icon.astro';
import type { Post } from '../lib/posts';
interface Props { items: Post[]; page: number; pages: number }
const { items, page, pages } = Astro.props;
const href = (n: number) => (n === 1 ? '/prensa' : `/prensa/page/${n}`);
const [feat, ...rest] = items;
---
<PageHero
  eyebrow="Sala de prensa"
  title={page === 1 ? 'Noticias de Servicios Sociales' : `Noticias · página ${page}`}
  lead="Actividades del Centro del Mayor, convenios, programas y novedades de la Consejería de Sanidad y Servicios Sociales de Ceuta."
  crumbs={[{ label: 'Noticias' }]}
/>
<section class="section section--tight nl">
  <div class="wrap">
    {page === 1 && feat && <div class="nl__feat" data-reveal><PostCard post={feat} featured headingLevel="h2" /></div>}
    <ul class="grid-3 nl__grid" data-stagger>
      {(page === 1 ? rest : items).map((p) => <li><PostCard post={p} headingLevel="h2" /></li>)}
    </ul>
    {pages > 1 && (
      <nav class="pag" aria-label="Paginación">
        {page > 1 ? <a class="pag__arrow pag__prev" href={href(page - 1)} rel="prev" aria-label="Página anterior"><Icon name="arrow" /></a> : <span />}
        <ol>
          {Array.from({ length: pages }, (_, i) => i + 1).map((n) => (
            <li>{n === page ? <span aria-current="page">{n}</span> : <a href={href(n)}>{n}</a>}</li>
          ))}
        </ol>
        {page < pages ? <a class="pag__arrow" href={href(page + 1)} rel="next" aria-label="Página siguiente"><Icon name="arrow" /></a> : <span />}
      </nav>
    )}
  </div>
</section>

<style>
  .nl { padding-top: 0; }
  .nl__feat { margin-bottom: var(--gap); }
  .nl__grid { list-style: none; margin: 0; padding: 0; }
  .pag { display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: max(2.5rem, 4vw); }
  .pag ol { list-style: none; display: flex; gap: 0.4rem; margin: 0; padding: 0; }
  .pag a, .pag span[aria-current] { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; text-decoration: none; font-weight: 700; color: var(--azul-900); background: #fff; border: 1px solid var(--linea); }
  .pag a:hover { border-color: var(--azul-700); }
  .pag span[aria-current] { background: var(--azul-900); color: #fff; border-color: var(--azul-900); }
  .pag__prev :global(svg) { transform: rotate(180deg); }
</style>
