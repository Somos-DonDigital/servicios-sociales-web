---
import { getImage } from 'astro:assets';
import Pic from './Pic.astro';
import Icon from './Icon.astro';
import { img } from '../lib/img';
interface Props { images: string[]; alt: string; title?: string }
const { images, alt, title } = Astro.props;
const full = await Promise.all(images.map((n) => getImage({ src: img(n), width: Math.min(img(n).width, 1800), format: 'webp' })));
---
<div class="gal">
  {title && <h2 class="gal__t" data-reveal>{title}</h2>}
  <ul class="gal__grid" data-gallery data-stagger>
    {images.map((n, i) => (
      <li>
        <a href={full[i].src} aria-label={`Ampliar imagen ${i + 1} de ${images.length}`}>
          <Pic src={n} alt={`${alt} (${i + 1})`} sizes="(min-width: 1080px) 33vw, (min-width: 640px) 50vw, 100vw" widths={[480, 768, 1080]} />
        </a>
      </li>
    ))}
  </ul>
</div>

<dialog class="lb" data-lightbox aria-label="Visor de imágenes">
  <img src="" alt="" />
  <button class="lb__btn lb__close" data-lb-close aria-label="Cerrar"><Icon name="close" /></button>
  <button class="lb__btn lb__prev" data-lb-prev aria-label="Anterior"><Icon name="arrow" /></button>
  <button class="lb__btn lb__next" data-lb-next aria-label="Siguiente"><Icon name="arrow" /></button>
  <p class="lb__count" data-lb-count></p>
</dialog>

<style>
  .gal__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: max(0.75rem, 1vw); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 900px) { .gal__grid { grid-template-columns: repeat(3, 1fr); } }
  .gal__grid li:nth-child(5n + 1) { grid-row: span 2; }
  .gal__grid a { display: block; height: 100%; min-height: 160px; border-radius: var(--radius-sm); overflow: hidden; position: relative; background: var(--azul-100); }
  .gal__grid :global(picture), .gal__grid :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .gal__grid a:hover :global(img) { transform: scale(1.05); }
  .gal__grid a::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(13,27,54,.35), transparent 50%); opacity: 0; transition: opacity 0.4s; }
  .gal__grid a:hover::after { opacity: 1; }
</style>
