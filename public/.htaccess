# Apache (hosting tradicional)
Options -MultiViews
RewriteEngine On
ErrorDocument 404 /404.html

# Forzar HTTPS y www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.servicios-sociales.es%{REQUEST_URI} [L,R=301]

# Quitar .html y barra final
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# URL antiguas de Wix
RewriteRule ^blog(/.*)?$ /prensa [R=301,L]
RewriteRule ^prensa/(hashtags|categories|categoria)/.*$ /prensa [R=301,L]
RewriteRule ^(inicio|home|index)$ / [R=301,L]

# Servir /pagina desde /pagina.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|woff2|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
